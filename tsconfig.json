{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "ESNext.Intl",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "useUnknownInCatchVariables": false,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "types": [
      "node",
      "bun"
    ],
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "src/**/*.ts",
    "bin/**/*.ts",
    "scripts/**/*.ts"
  ]
}
