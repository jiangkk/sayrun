{
  "name": "sayrun-shell",
  "version": "0.1.4",
  "type": "module",
  "description": "Sayrun: an AI terminal assistant for zsh. Use natural language, approve each command, and keep your shell workflow. Powered by your installed DeepSeek Harness (DSH).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiangkk/sayrun.git"
  },
  "license": "MIT",
  "homepage": "https://github.com/jiangkk/sayrun#readme",
  "bugs": {
    "url": "https://github.com/jiangkk/sayrun/issues"
  },
  "keywords": [
    "sayrun",
    "shell",
    "zsh",
    "terminal",
    "cli",
    "ai",
    "agent",
    "ai-assistant",
    "terminal-assistant",
    "shell-assistant",
    "natural-language",
    "deepseek",
    "deepseek-harness",
    "dsh"
  ],
  "files": [
    "dist/",
    "docs/images/approval-preview.png"
  ],
  "os": [
    "darwin",
    "linux"
  ],
  "bin": {
    "sayrun": "./dist/sayrun.js"
  },
  "scripts": {
    "test": "node --import tsx --test test/*.test.mjs && bun test test/ui.test.ts",
    "preview": "node dist/sayrun.js preview",
    "test:pty": "python3 test/terminal-pty.py && python3 test/history-pty.py && python3 test/commands-pty.py",
    "doctor": "node dist/sayrun.js doctor",
    "test:package": "python3 test/package-install.py",
    "test:dsh": "node --import tsx test/dsh-native-smoke.mjs",
    "export:public": "node scripts/export-public.mjs",
    "build": "npm run typecheck && bun scripts/build.ts",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build",
    "pretest": "npm run build",
    "test:build": "npm run build && node --import tsx --test test/build.test.mjs",
    "typecheck": "tsc --noEmit",
    "prepreview": "npm run build",
    "predoctor": "npm run build",
    "pretest:pty": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@opentui/core": "0.6.6",
    "bun": "1.4.3",
    "marked": "17.0.1",
    "smol-toml": "1.9.1",
    "string-width": "7.2.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
